{
    "rewrites": [
        {
            "source": "/",
            "has": [{ "type": "query", "key": "view", "value": "png" }],
            "destination": "/api/render"
        },
        {
            "source": "/:path*",
            "has": [{ "type": "query", "key": "view", "value": "png" }],
            "destination": "/api/render"
        }
    ],
    "functions": {
        "api/render.ts": {
            "includeFiles": "src/**"
        }
    }
}
