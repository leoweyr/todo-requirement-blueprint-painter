{
  "name": "todo-requirement-blueprint-painter",
  "private": true,
  "version": "1.1.1",
  "description": "A bidirectional visual editor for TODO Requirement Blueprints (TRB). Render YAML into interactive graphs, mutate architecture visually, and sync back to code.",
  "bugs": "https://github.com/leoweyr/todo-requirement-blueprint-painter/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "keywords": [
    "architecture-as-code",
    "visual-editor",
    "bidirectional-sync",
    "diagramming-tool",
    "interactive-graph",
    "visual-programming",
    "trb-spec",
    "topology-graph",
    "low-code",
    "dag-layout",
    "barycenter-algorithm",
    "graph-theory",
    "edge-crossing-minimization",
    "collision-detection",
    "infinite-canvas"
  ],
  "author": "leoweyr <contact@leoweyr.com>",
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/dom-to-image": "^2.6.7",
    "@types/html2canvas": "^0.5.35",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "git-cliff": "^2.12.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leoweyr/todo-requirement-blueprint-painter"
  }
}
